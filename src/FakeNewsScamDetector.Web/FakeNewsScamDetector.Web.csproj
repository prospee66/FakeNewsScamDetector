<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FakeNewsScamDetector.Core\FakeNewsScamDetector.Core.csproj" />
    <ProjectReference Include="..\FakeNewsScamDetector.ML\FakeNewsScamDetector.ML.csproj" />
    <ProjectReference Include="..\FakeNewsScamDetector.Services\FakeNewsScamDetector.Services.csproj" />
    <ProjectReference Include="..\FakeNewsScamDetector.Data\FakeNewsScamDetector.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
