@model List<FakeNewsScamDetector.Core.Entities.AnalysisResult>
@{
    ViewData["Title"] = "History";
}

<h1 class="mb-3">Recent Analyses</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">No analyses yet. <a asp-controller="Analysis" asp-action="Index">Run your first one</a>.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Text</th>
                <th>Verdict</th>
                <th>Confidence</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AnalyzedAtUtc.ToString("g")</td>
                    <td>@(item.InputText.Length > 80 ? item.InputText[..80] + "…" : item.InputText)</td>
                    <td>@item.Verdict</td>
                    <td>@item.ConfidenceScore.ToString("P0")</td>
                    <td><a asp-controller="Analysis" asp-action="Result" asp-route-id="@item.Id">View</a></td>
                </tr>
            }
        </tbody>
    </table>
}
