@model List<FakeNewsScamDetector.Core.Entities.AnalysisResult>
@{
    ViewData["Title"] = "History";
}

<h1 class="mb-3">Recent Analyses</h1>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-3">No analyses yet.</p>
            <a asp-controller="Analysis" asp-action="Index" class="btn btn-primary">Run your first analysis</a>
        </div>
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Text</th>
                <th>Verdict</th>
                <th>Confidence</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var verdictSlug = item.Verdict.ToString().ToLowerInvariant();
                <tr>
                    <td class="text-muted">@item.AnalyzedAtUtc.ToString("g")</td>
                    <td>@(item.InputText.Length > 70 ? item.InputText[..70] + "…" : item.InputText)</td>
                    <td><span class="verdict-badge verdict-@verdictSlug">@item.Verdict</span></td>
                    <td>@item.ConfidenceScore.ToString("P0")</td>
                    <td><a asp-controller="Analysis" asp-action="Result" asp-route-id="@item.Id">View &rarr;</a></td>
                </tr>
            }
        </tbody>
    </table>
}
