@model FakeNewsScamDetector.Core.Entities.AnalysisResult
@{
    ViewData["Title"] = "Analysis Result";
    var verdictSlug = Model.Verdict.ToString().ToLowerInvariant();
    var verdictAlertClass = Model.Verdict switch
    {
        FakeNewsScamDetector.Core.Enums.VerdictType.Legitimate => "success",
        FakeNewsScamDetector.Core.Enums.VerdictType.Suspicious => "warning",
        _ => "danger"
    };
    var confidenceTier = Model.ConfidenceScore switch
    {
        < 0.45 => "Low confidence",
        < 0.7 => "Medium confidence",
        _ => "High confidence"
    };
    var isChatDerived = Model.ConversationTranscript.Count > 0;
}

<div style="max-width: 720px; margin: 0 auto;">
    <div class="page-header">
        <span class="kicker">Result</span>
        <h1>Analysis result</h1>
    </div>

    <div class="alert alert-@verdictAlertClass mb-2">
        <span class="verdict-badge verdict-@verdictSlug">@Html.Raw(IconHelper.VerdictIcon(Model.Verdict)) @Model.Verdict</span>
        &nbsp;&mdash;&nbsp; @confidenceTier (@Model.ConfidenceScore.ToString("P0"))
    </div>
    <p class="text-muted mb-4" style="font-size: 0.88rem;">
        This is an automated pattern-matching signal, not a fact-check or a guarantee. Treat it as a prompt to look closer, not a final answer &mdash; verify independently before acting, especially for anything financial or time-pressured.
    </p>

    @if (Model.FactCheckFindings.Count > 0)
    {
        <div class="card mb-4" style="border-color: var(--color-primary); border-width: 1.5px;">
            <div class="card-body">
                <h5 class="mb-1" style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary-dark);">Reviewed by Independent Fact-Checkers</h5>
                <p class="text-muted mb-3" style="font-size: 0.85rem;">These are real published reviews of a similar claim &mdash; read the source, not just the label below.</p>
                @foreach (var finding in Model.FactCheckFindings)
                {
                    <div class="mb-3 pb-3" style="border-bottom: 1px solid var(--color-border);">
                        <span class="verdict-badge" style="background: var(--color-primary-soft); color: var(--color-primary-dark);">@finding.TextualRating</span>
                        <span class="text-muted" style="font-size: 0.85rem;"> &mdash; @finding.Publisher</span>
                        <p class="mb-1 mt-1">@finding.ClaimText</p>
                        @if (!string.IsNullOrEmpty(finding.ReviewUrl))
                        {
                            <a href="@finding.ReviewUrl" target="_blank" rel="noopener noreferrer" style="font-size: 0.85rem;">Read the full review &rarr;</a>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (!isChatDerived)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="mb-3" style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted);">Score Breakdown</h5>

                <div class="score-row">
                    <span class="score-label">ML Model</span>
                    <div class="score-track"><div class="score-fill" style="width: @(Model.MlScore * 100)%;"></div></div>
                    <span class="score-value">@Model.MlScore.ToString("P0")</span>
                </div>
                <div class="score-row">
                    <span class="score-label">Rule Engine</span>
                    <div class="score-track"><div class="score-fill" style="width: @(Model.RuleScore * 100)%;"></div></div>
                    <span class="score-value">@Model.RuleScore.ToString("P0")</span>
                </div>
                @if (Model.InputUrl is not null)
                {
                    <div class="score-row">
                        <span class="score-label">URL Risk</span>
                        <div class="score-track"><div class="score-fill" style="width: @(Model.UrlRiskScore * 100)%;"></div></div>
                        <span class="score-value">@Model.UrlRiskScore.ToString("P0")</span>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="mb-3" style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted);">AI Conversation Transcript</h5>
                <p class="text-muted mb-3" style="font-size: 0.85rem;">This verdict came from a chat with the AI assistant, not the scored ML/rule pipeline &mdash; there's no comparable percentage breakdown to show.</p>
                @foreach (var line in Model.ConversationTranscript)
                {
                    <p class="mb-2" style="white-space: pre-wrap;">@line</p>
                }
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="mb-3" style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted);">Analyzed Content</h5>
            <p style="white-space: pre-wrap;">@Model.InputText</p>
            @if (Model.InputUrl is not null)
            {
                <p class="text-muted mb-0"><strong>Detected URL:</strong> @Model.InputUrl</p>
            }
            <p class="text-muted mb-0"><strong>Analyzed:</strong> @Model.AnalyzedAtUtc.ToString("u")</p>
        </div>
    </div>

    @if (Model.Reasons.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="mb-3" style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted);">Why This Verdict</h5>
                <ul class="mb-0" style="padding-left: 1.2rem;">
                    @foreach (var reason in Model.Reasons)
                    {
                        <li class="mb-1">@reason</li>
                    }
                </ul>
            </div>
        </div>
    }

    <a asp-controller="Analysis" asp-action="Index" class="btn btn-primary">Analyze Another</a>
    <a asp-controller="Analysis" asp-action="History" class="btn btn-outline-secondary">View History</a>
</div>
