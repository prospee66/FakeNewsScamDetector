@model FakeNewsScamDetector.Core.Entities.AnalysisResult
@{
    ViewData["Title"] = "Analysis Result";
    var verdictClass = Model.Verdict switch
    {
        FakeNewsScamDetector.Core.Enums.VerdictType.Legitimate => "success",
        FakeNewsScamDetector.Core.Enums.VerdictType.Suspicious => "warning",
        _ => "danger"
    };
}

<h1 class="mb-3">Analysis Result</h1>

<div class="alert alert-@verdictClass">
    <strong>Verdict: @Model.Verdict</strong> &mdash; Confidence: @Model.ConfidenceScore.ToString("P0")
</div>

<dl class="row">
    <dt class="col-sm-3">Analyzed text</dt>
    <dd class="col-sm-9">@Model.InputText</dd>

    @if (Model.InputUrl is not null)
    {
        <dt class="col-sm-3">Detected URL</dt>
        <dd class="col-sm-9">@Model.InputUrl (risk: @Model.UrlRiskScore.ToString("P0"))</dd>
    }

    <dt class="col-sm-3">ML score</dt>
    <dd class="col-sm-9">@Model.MlScore.ToString("P0")</dd>

    <dt class="col-sm-3">Rule score</dt>
    <dd class="col-sm-9">@Model.RuleScore.ToString("P0")</dd>

    <dt class="col-sm-3">Analyzed at</dt>
    <dd class="col-sm-9">@Model.AnalyzedAtUtc.ToString("u")</dd>
</dl>

@if (Model.Reasons.Count > 0)
{
    <h5>Reasons</h5>
    <ul>
        @foreach (var reason in Model.Reasons)
        {
            <li>@reason</li>
        }
    </ul>
}

<a asp-controller="Analysis" asp-action="Index" class="btn btn-primary">Analyze Another</a>
<a asp-controller="Analysis" asp-action="History" class="btn btn-outline-secondary">View History</a>
