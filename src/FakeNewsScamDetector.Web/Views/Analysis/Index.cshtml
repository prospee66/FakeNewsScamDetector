@model FakeNewsScamDetector.Web.Models.AnalyzeRequestViewModel
@{
    ViewData["Title"] = "Analyze";
}

<div style="max-width: 640px; margin: 0 auto;">
    <div class="page-header">
        <span class="kicker">Analyze</span>
        <h1>Text or URL</h1>
        <p class="lead-muted">Paste a message, news snippet, or link below to check it for scam and fake-news signals.</p>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-controller="Analysis" asp-action="Analyze" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="InputText" class="form-label">Text to analyze</label>
                    <textarea asp-for="InputText" class="form-control" rows="8" placeholder="Paste text, a message, or a URL here..."></textarea>
                    <span asp-validation-for="InputText" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Analyze</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
