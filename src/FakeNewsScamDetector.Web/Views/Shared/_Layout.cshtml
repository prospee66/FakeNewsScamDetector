@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    Func<string, string> navClass = c => "nav-link" + (currentController == c ? " active" : "");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fake News &amp; Scam Detector</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FakeNewsScamDetector.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="app-nav navbar navbar-expand-sm">
            <div class="container-fluid" style="max-width: 1080px; margin: 0 auto;">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">@Html.Raw(IconHelper.Svg("shield"))</span> Truthlens
                </a>
                <button class="navbar-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon-open">@Html.Raw(IconHelper.Svg("menu"))</span>
                    <span class="navbar-toggler-icon-close">@Html.Raw(IconHelper.Svg("x"))</span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 justify-content-end">
                        <li class="nav-item">
                            <a class="@navClass("Home")" asp-area="" asp-controller="Home" asp-action="Index">@Html.Raw(IconHelper.Svg("home")) <span>Home</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="@navClass("Analysis")" asp-area="" asp-controller="Analysis" asp-action="Index">@Html.Raw(IconHelper.Svg("search")) <span>Analyze</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Analysis" asp-action="History">@Html.Raw(IconHelper.Svg("clock")) <span>History</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="@navClass("Chat")" asp-area="" asp-controller="Chat" asp-action="Index">@Html.Raw(IconHelper.Svg("message-circle")) <span>AI Chat</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="@navClass("Dashboard")" asp-area="" asp-controller="Dashboard" asp-action="Index">@Html.Raw(IconHelper.Svg("bar-chart")) <span>Dashboard</span></a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="page-section">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container">
            <p class="mb-1">&copy; 2026 Truthlens &mdash; Fake News &amp; Scam Detector</p>
            <p class="mb-0" style="font-size: 0.8rem; opacity: 0.85;">Automated signals, not verified fact-checks. Always verify independently before acting on anything financial or urgent.</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
