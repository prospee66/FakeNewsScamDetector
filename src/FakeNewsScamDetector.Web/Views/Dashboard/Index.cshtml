@model FakeNewsScamDetector.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">Dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-md">
        <div class="card"><div class="card-body text-center"><h5>@Model.TotalAnalyzed</h5><p class="text-muted mb-0">Total Analyzed</p></div></div>
    </div>
    <div class="col-6 col-md">
        <div class="card"><div class="card-body text-center"><h5 style="color: var(--color-success);">@Model.LegitimateCount</h5><p class="text-muted mb-0">Legitimate</p></div></div>
    </div>
    <div class="col-6 col-md">
        <div class="card"><div class="card-body text-center"><h5 style="color: var(--color-warning);">@Model.SuspiciousCount</h5><p class="text-muted mb-0">Suspicious</p></div></div>
    </div>
    <div class="col-6 col-md">
        <div class="card"><div class="card-body text-center"><h5 style="color: var(--color-danger);">@Model.ScamCount</h5><p class="text-muted mb-0">Scam</p></div></div>
    </div>
    <div class="col-6 col-md">
        <div class="card"><div class="card-body text-center"><h5 style="color: var(--color-danger);">@Model.FakeNewsCount</h5><p class="text-muted mb-0">Fake News</p></div></div>
    </div>
</div>

<h4 class="mb-3">Recent Results</h4>
@if (Model.RecentResults.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-0">No analyses yet.</p>
        </div>
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr><th>Date</th><th>Text</th><th>Verdict</th><th>Confidence</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.RecentResults)
            {
                var verdictSlug = item.Verdict.ToString().ToLowerInvariant();
                <tr>
                    <td class="text-muted">@item.AnalyzedAtUtc.ToString("g")</td>
                    <td>@(item.InputText.Length > 60 ? item.InputText[..60] + "…" : item.InputText)</td>
                    <td><span class="verdict-badge verdict-@verdictSlug">@item.Verdict</span></td>
                    <td>@item.ConfidenceScore.ToString("P0")</td>
                </tr>
            }
        </tbody>
    </table>
}
