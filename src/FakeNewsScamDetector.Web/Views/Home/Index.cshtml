@{
    ViewData["Title"] = "Home";
}

<div class="hero-banner">
    <div class="hero-inner">
        <div class="hero-intro">
            <span class="kicker">Scam &amp; fake news detection</span>
            <h1>See through scams and misinformation.</h1>
            <p class="lead">Paste a message, article, or link and get a clear verdict in seconds, along with the reasons behind it &mdash; no technical background needed.</p>
            <a asp-controller="Analysis" asp-action="Index" class="btn btn-primary btn-lg">
                Analyze Text or URL @Html.Raw(IconHelper.Svg("arrow-right"))
            </a>
        </div>
    </div>
</div>

<div class="hero">
    <div class="feature-grid">
        <div class="feature-card">
            <div class="feature-icon">@Html.Raw(IconHelper.Svg("cpu"))</div>
            <h3>Smart Pattern Detection</h3>
            <p>Trained on real examples of scams and fake news, it recognizes suspicious writing patterns most people would miss.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">@Html.Raw(IconHelper.Svg("search"))</div>
            <h3>Red Flag Checklist</h3>
            <p>Automatically checks for common warning signs, like urgent pressure, gift card requests, or wire transfer demands.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">@Html.Raw(IconHelper.Svg("link"))</div>
            <h3>Link Safety Check</h3>
            <p>Looks at any link included and flags things like disguised web addresses or shortened links hiding where they really go.</p>
        </div>
    </div>
</div>
